{
  "name": "@candledottv/agent-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Candle agent rail: typed headless launches, market reads, and webhook verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/candledottv/agentic.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.candle.tv/developers/sdk",
  "bugs": {
    "url": "https://github.com/candledottv/agentic/issues"
  },
  "keywords": [
    "candle",
    "solana",
    "agent",
    "sdk",
    "token-launch",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:js": "bun build src/index.ts --target=node --format=esm --packages=external --outfile=dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "^1.6.2",
    "@hpke/core": "^1.7.2",
    "@scure/base": "^1.2.6",
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "@privy-io/server-auth": "^1.32.5",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
