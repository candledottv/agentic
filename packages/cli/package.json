{
  "name": "@candledottv/cli",
  "version": "0.8.3",
  "description": "The Candle CLI: authorize a device from your browser, then manage API keys, wallets, and setup health from the terminal",
  "type": "module",
  "bin": {
    "candle": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/candledottv/agentic.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.candle.tv/developers",
  "bugs": {
    "url": "https://github.com/candledottv/agentic/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.js",
    "build:binary": "bun build --compile --minify src/index.ts --outfile dist-bin/candle",
    "refresh-sigstore-root": "bun scripts/refresh-sigstore-root.mjs",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@hpke/chacha20poly1305": "^1.6.2",
    "@hpke/core": "^1.7.2",
    "@modelcontextprotocol/sdk": "1.22.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/tuf": "5.0.0",
    "@sigstore/verify": "4.1.2",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2",
    "zod": "^3.23.0"
  }
}
