<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The data-protection keychain, which is where a kSecAttrTokenIDSecureEnclave key lives, admits
       a Developer ID app through its application identifier and keychain access group, both with
       the team prefix (CC-03). The team id is substituted by the release job from the certificate
       it signs with; an unsigned development build has no identity and cannot create the key. -->
  <key>com.apple.application-identifier</key>
  <string>__TEAM_ID__.__BUNDLE_ID__</string>
  <key>keychain-access-groups</key>
  <array>
    <string>__TEAM_ID__.__BUNDLE_ID__</string>
  </array>
  <!-- No com.apple.developer.associated-domains entitlement (BE-3251, 2026-11-12): the synced passkey
       factor (BE-135) needs webcredentials:cli.candle.tv in BOTH this entitlement and the Developer ID
       provisioning profile, plus a cli.candle.tv apple-app-site-association listing this app. The
       current profile has no Associated Domains and the AASA lists no app, so this helper ships the
       Secure Enclave (Touch ID) factor only. The CLI already reports passkey as unavailable when the
       helper's associatedDomains is empty (vault/platform.ts). The profile is still embedded: it
       authorizes the application identifier and keychain access group above. Adding passkeys back
       is this entitlement, a profile with Associated Domains, and the AASA entry (T57). -->
  <!-- Hardened runtime, no exceptions: no JIT, no unsigned memory, no library validation bypass. -->
</dict>
</plist>
